---
// About 서비스(styles/variable.css)의 디자인 토큰을 블로그에 맞춰 옮겼다.
// 브랜드 컬러는 민트(#00c2b3), 본문 그레이 스케일도 동일 계열을 쓴다.
// 폰트는 Pretendard 가변 폰트를 self-host 한다 (public/fonts/pretendard).
---

<link rel="stylesheet" href="/fonts/pretendard/pretendardvariable-dynamic-subset.css" />

<style is:inline>
  :root {
    /* About의 gray 스케일 */
    --gray-900: #282828;
    --gray-800: #424242;
    --gray-700: #616161;
    --gray-600: #757575;
    --gray-500: #9e9e9e;
    --gray-400: #bdbdbd;
    --gray-300: #e0e0e0;
    --gray-200: #eeeeee;
    --gray-100: #f5f5f5;

    --color-mint: #00c2b3;
    --color-mint-light: rgba(0, 194, 179, 0.1);

    --aw-font-sans: 'Pretendard Variable', Pretendard, -apple-system,
      BlinkMacSystemFont, system-ui, sans-serif;
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);

    --aw-color-primary: var(--color-mint);
    --aw-color-secondary: #00a89b;
    --aw-color-accent: var(--color-mint);

    --aw-color-text-heading: var(--gray-900);
    --aw-color-text-default: var(--gray-800);
    --aw-color-text-muted: var(--gray-600);
    --aw-color-bg-page: #ffffff;

    ::selection {
      background-color: var(--color-mint-light);
    }
  }

  .dark {
    --aw-font-sans: 'Pretendard Variable', Pretendard, -apple-system,
      BlinkMacSystemFont, system-ui, sans-serif;
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);

    --aw-color-primary: #2dd4bf;
    --aw-color-secondary: #14b8a6;
    --aw-color-accent: #2dd4bf;

    --aw-color-text-heading: #f5f5f5;
    --aw-color-text-default: #d4d4d4;
    --aw-color-text-muted: #a3a3a3;
    --aw-color-bg-page: #17181a;

    ::selection {
      background-color: rgba(45, 212, 191, 0.2);
    }
  }

  /* 한글 본문 가독성.
     Pretendard는 영문 기준 기본 자간이 좁아 한글에서 답답해 보인다. */
  html {
    font-family: var(--aw-font-sans);
    letter-spacing: -0.01em;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  body {
    background-color: var(--aw-color-bg-page);
    color: var(--aw-color-text-default);
  }
</style>
