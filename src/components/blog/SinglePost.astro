---
import Image from '~/components/common/Image.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

{/* 본문 폭은 About의 --max-width(628px)보다는 넓게 두되, 한 줄이
    너무 길어지지 않도록 max-w-2xl(672px) 선에서 잡는다. */}
<section class="py-10 sm:py-14 mx-auto">
  <article>
    <header class="max-w-2xl mx-auto px-5 mb-10">
      <div class="mb-3 text-sm text-muted">
        <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
        {
          post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
            <>
              <span class="mx-1.5 opacity-40">·</span>
              <span>
                수정 <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
              </span>
            </>
          )
        }
        {
          post.readingTime && (
            <>
              <span class="mx-1.5 opacity-40">·</span>
              <span>{post.readingTime}분 분량</span>
            </>
          )
        }
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold leading-snug tracking-tight text-heading mb-4">
        {post.title}
      </h1>

      {post.excerpt && <p class="text-lg text-muted leading-relaxed">{post.excerpt}</p>}

      {
        post.tags && Array.isArray(post.tags) && post.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {post.tags.map((tag) => (
              <span class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-800 text-muted">
                {typeof tag === 'string' ? tag : tag.title}
              </span>
            ))}
          </div>
        )
      }

      <div class="mt-8 border-t border-gray-200 dark:border-slate-800"></div>
    </header>

    {
      post.image && (
        <Image
          src={post.image}
          class="max-w-2xl w-full mx-auto mb-10 rounded-lg"
          widths={[400, 900]}
          sizes="(max-width: 900px) 400px, 900px"
          alt={post.imageAlt || ''}
          width={900}
          height={506}
          format="webp"
          loading="eager"
          decoding="async"
        />
      )
    }

    <div class="post-body mx-auto px-5 max-w-2xl prose dark:prose-invert">
      <slot />
    </div>

    <div class="mx-auto px-5 max-w-2xl mt-12 pt-6 border-t border-gray-200 dark:border-slate-800">
      <SocialShare url={url} text={post.title} class="text-gray-500 dark:text-slate-500" />
    </div>
  </article>
</section>
