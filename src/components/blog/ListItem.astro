---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

{/* 글 중심 블로그라 커버 이미지는 있을 때만 작게 곁들인다.
    원본 AstroWind는 이미지가 없으면 레이아웃이 비어 보였다. */}
<article class="group py-8 border-b border-gray-200 dark:border-slate-800 last:border-0">
  <a class="block" href={link}>
    <div class={image ? 'grid gap-5 sm:grid-cols-[1fr_180px] sm:items-start' : ''}>
      <div>
        <div class="mb-2 text-sm text-muted">
          <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
          {
            post.category && (
              <>
                <span class="mx-1.5 opacity-40">·</span>
                <span>{post.category.title}</span>
              </>
            )
          }
        </div>

        <h2
          class="text-xl sm:text-2xl font-bold leading-snug tracking-tight mb-2 text-heading group-hover:text-primary transition-colors duration-200"
        >
          {post.title}
        </h2>

        {post.excerpt && <p class="text-muted leading-relaxed line-clamp-3">{post.excerpt}</p>}

        {
          post.tags && Array.isArray(post.tags) && post.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {post.tags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-800 text-muted">
                  {typeof tag === 'string' ? tag : tag.title}
                </span>
              ))}
            </div>
          )
        }
      </div>

      {
        image && (
          <div class="hidden sm:block overflow-hidden rounded-lg">
            <Image
              src={image}
              class="w-full h-[120px] object-cover transition-transform duration-300 group-hover:scale-105"
              widths={[180, 360]}
              width={360}
              height={240}
              sizes="180px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </div>
        )
      }
    </div>
  </a>
</article>
