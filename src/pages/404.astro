---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const metadata = {
  title: '페이지를 찾을 수 없습니다',
};
---

<Layout metadata={metadata}>
  <section class="flex items-center justify-center py-24 sm:py-32">
    <div class="max-w-md px-5 text-center">
      <p class="text-6xl font-bold text-primary mb-6">404</p>
      <h1 class="text-2xl font-bold text-heading mb-3">페이지를 찾을 수 없습니다</h1>
      <p class="text-muted mb-8">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
      <a href={getHomePermalink()} class="btn">글 목록으로</a>
    </div>
  </section>
</Layout>
